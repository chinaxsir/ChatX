{
  "name": "frapi-updates",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx wrangler pages dev . --local --d1=DB --r2=FILES",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy.ps1",
    "db:init": "npx wrangler d1 execute frapi-updates-db --file=schema.sql --remote",
    "db:init:local": "npx wrangler d1 execute frapi-updates-db --file=schema.sql --local"
  }
}
