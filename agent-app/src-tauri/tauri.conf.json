{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-app",
  "version": "2.1.0",
  "identifier": "com.frapi.agent-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Frapi AI",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://ibest.kdns.fr/app-updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2ODNFNkJDN0IzOTY0RUIKUldUclpEbDd2T2FEaG5zOW5CWEdGeGF1aWRHdlBtQzU4ckRoM0prdGFTM1dvUHVTbFVOL2YrNWMK"
    }
  }
}
