{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-only",
  "description": "桌面端专属能力：系统托盘、全局快捷键、应用内自动更新（移动端不编译这些插件）",
  "platforms": ["windows", "linux", "macOS"],
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "global-shortcut:default",
    "core:tray:default"
  ]
}
